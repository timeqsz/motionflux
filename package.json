{
  "name": "motionflux",
  "version": "0.7.0",
  "description": "Deterministic HTML/CSS/SVG/WebGL motion stage, procedural SFX, DOM visual audit, and 53 independent 2D motion atoms",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/timeqsz/motionflux.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node maintainer/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "node maintainer/verify.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "esbuild": "0.25.5",
    "three": "0.187.0",
    "typescript": "5.8.3"
  }
}
